# Copy to .env to override docker-compose.yml's defaults. Not required —
# `docker compose up` works out of the box without this file. Jira
# credentials are NOT set here; you enter those through the in-app setup
# wizard on first run (they get written to a Docker volume, not this file).

# MySQL (used by Chat, Dev Tracker, Password Manager)
DB_NAME=jira_chat
DB_USER=veau
DB_PASSWORD=veau
DB_ROOT_PASSWORD=veau_root

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=8080
